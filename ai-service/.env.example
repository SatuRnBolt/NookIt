# --- LLM (DeepSeek by default, OpenAI-compatible) ---
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-your-deepseek-api-key
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOOL_STEPS=8

# --- MySQL (same instance as the Java backend) ---
# Match backend/src/main/resources/application-dev.yml
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=study_room
DB_USER=root
DB_PASSWORD=12345678

# --- JWT (MUST match backend nookit.jwt.secret / issuer) ---
NOOKIT_JWT_SECRET=please-change-me-please-change-me-please
NOOKIT_JWT_ISSUER=nookit

# --- Java backend base (used for tool calls) ---
JAVA_BASE_URL=http://127.0.0.1:8080/api

# --- Redis (optional; rate-limit silently disabled if unreachable) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
RATE_LIMIT_PER_MINUTE=10

# --- Long-conversation summarization ---
SUMMARIZE_THRESHOLD_MESSAGES=30
SUMMARIZE_KEEP_RECENT=20
SUMMARIZE_MIN_NEW_MESSAGES=10

# --- HTTP server ---
HOST=0.0.0.0
PORT=8081
LOG_LEVEL=INFO
